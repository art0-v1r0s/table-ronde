/* Base Screen */
Screen {
    background: $surface;
    color: $text;
}

/* AgentMessageWidget */
AgentMessageWidget {
    margin: 1 2;
    padding: 0 1;
    border: round $primary;
    background: $panel;
    height: auto;
}
AgentMessageWidget.done {
    border: round $success;
}
AgentMessageWidget.errored {
    border: round $error;
}
AgentMessageWidget.cancelled {
    border: round $warning;
}

/* SidebarInfo */
SidebarInfo {
    width: 100%;
    height: auto;
    padding: 1 2;
}

/* SetupScreen */
SetupScreen {
    background: $surface;
}

#setup-container {
    width: 100%;
    height: 1fr;
    background: $surface;
    padding: 1 4;
}

.input-row {
    height: 4;
    margin-bottom: 1;
}

.input-col {
    width: 1fr;
    height: auto;
    margin-right: 2;
}

#setup-title {
    text-align: center;
    text-style: bold;
    color: $accent;
    margin-bottom: 2;
}

#setup-container Label {
    margin-top: 1;
    color: $text-muted;
}

#setup-container Input, #setup-container Select, #setup-container TextArea {
    margin-bottom: 1;
}

#setup-buttons {
    height: auto;
    margin-top: 2;
    align: center middle;
}

#setup-buttons Button {
    margin: 0 2;
}

/* DebateScreen */
DebateScreen {
    layout: horizontal;
}

#sidebar {
    width: 35;
    height: 100%;
    border-right: vkey $primary;
    background: $panel-darken-1;
}

#sidebar-title {
    padding: 1 2;
    text-style: bold;
    color: $accent;
    border-bottom: hkey $primary;
    text-align: center;
}

#arena-wrapper {
    width: 1fr;
    height: 100%;
    background: $surface;
}

#arena {
    height: 1fr;
    padding: 1 2;
}

#arena-empty {
    margin: 2;
    text-align: center;
    color: $text-muted;
    text-style: italic;
}

#status-bar {
    dock: bottom;
    height: 1;
    background: $primary;
    color: $background;
    padding: 0 2;
    text-style: bold;
}

/* HumanInputModal */
HumanInputModal {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

#modal-container {
    width: 60%;
    min-width: 50;
    max-width: 90;
    height: auto;
    max-height: 80%;
    border: round $warning;
    padding: 2 4;
    background: $panel;
}

#modal-title {
    text-align: center;
    text-style: bold;
    color: $warning;
    margin-bottom: 1;
}

#modal-container TextArea {
    height: 10;
    margin: 1 0;
    border: round $primary;
}

#modal-buttons {
    height: auto;
    margin-top: 2;
    align: center middle;
}

#modal-buttons Button {
    margin: 0 1;
}

/* PlanViewScreen */
PlanViewScreen {
    background: $surface;
}

#plan-container {
    height: 1fr;
    padding: 2 4;
    background: $panel;
    margin: 1 4;
    border: round $success;
}

#plan-buttons {
    dock: bottom;
    height: 3;
    align: center middle;
    background: $surface;
    padding: 0 2;
}

#plan-buttons Button {
    margin: 0 2;
}
